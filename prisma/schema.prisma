generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now()) @updatedAt
  language                String                  @default("en")
  auditLogs               AuditLog[]
  contacts                Contact[]
  customFields            CustomField[]
  forms                   Form[]
  formSubmissions         FormSubmission[]
  invoices                Invoice[]
  landingPages            LandingPage[]
  leads                   Lead[]
  ledgerEntries           LedgerEntry[]
  lowStockAlerts          LowStockAlert[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference?
  Payment                 Payment[]
  products                Product[]
  productVariants         ProductVariant[]
  stockAuditLogs          StockAuditLog[]
  stockTransfers          StockTransfer[]
  Tag                     Tag[]
  users                   User[]
  warehouses              Warehouse[]
  warehouseStocks         WarehouseStock[]
  whatsappMessages        WhatsAppMessage[]
  subscriptions           Subscription?
  settings                TenantSettings?
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  role          String     @default("staff")
  tenantId      String
  createdAt     DateTime   @default(now())
  refreshToken  String?
  language      String?
  avatarUrl     String?
  emailVerified Boolean    @default(false)
  firstName     String?
  inviteExpiry  DateTime?
  invitePending Boolean    @default(false)
  inviteToken   String?
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  lastName      String?
  permissions   Json?
  phone         String?
  updatedAt     DateTime   @default(now()) @updatedAt
  verifyExpiry  DateTime?
  verifyToken   String?
  metadata      Json?
  auditLogs     AuditLog[]
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
}

model Contact {
  id               String            @id @default(uuid())
  name             String
  email            String?
  phone            String?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  address          String?
  assignedTo       String?
  city             String?
  company          String?
  lastPurchaseAt   DateTime?
  notes            String?
  state            String?
  totalSpend       Float?            @default(0)
  type             String?           @default("customer")
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  invoices         Invoice[]
  whatsappMessages WhatsAppMessage[]
  tags             Tag[]             @relation("ContactTags")

  @@index([tenantId])
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  contacts  Contact[] @relation("ContactTags")
  leads     Lead[]    @relation("LeadTags")

  @@unique([name, tenantId])
}

model Product {
  id                String                 @id @default(uuid())
  name              String
  description       String?
  price             Float
  type              ProductType            @default(product)
  tenantId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt
  customFields      Json?
  unit              String?
  lowStockThreshold Int                    @default(5)
  stock             Int                    @default(0)
  currency          String                 @default("NGN")
  barcode           String?
  category          String?
  compareAtPrice    Float?
  costPrice         Float?
  imageUrl          String?
  isActive          Boolean                @default(true)
  sku               String?
  trackStock        Boolean                @default(true)
  bundleItems       BundleItem[]           @relation("BundleParent")
  includedInBundles BundleItem[]           @relation("BundleChild")
  complementaryTo   ComplementaryProduct[] @relation("CompTo")
  complementaryFrom ComplementaryProduct[] @relation("CompFrom")
  lineItems         LineItem[]
  lowStockAlerts    LowStockAlert[]
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  variants          ProductVariant[]
  stockAuditLogs    StockAuditLog[]
  stockTransfers    StockTransfer[]
  volumeDiscounts   VolumeDiscount[]
  warehouseStocks   WarehouseStock[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  tenantId     String
  name         String
  sku          String?
  costPrice    Float?
  sellingPrice Float?
  stock        Int      @default(0)
  imageUrl     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([tenantId])
}

model BundleItem {
  id        String  @id @default(uuid())
  bundleId  String
  productId String
  quantity  Int     @default(1)
  tenantId  String
  bundle    Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation("BundleChild", fields: [productId], references: [id])
}

model VolumeDiscount {
  id          String   @id @default(uuid())
  productId   String
  minQty      Int
  discountPct Float
  tenantId    String
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ComplementaryProduct {
  id           String  @id @default(uuid())
  productId    String
  complementId String
  tenantId     String
  complement   Product @relation("CompTo", fields: [complementId], references: [id])
  product      Product @relation("CompFrom", fields: [productId], references: [id], onDelete: Cascade)
}

model LowStockAlert {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  message   String
  sentVia   String
  sentAt    DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model StockAuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  changeType  String
  oldValue    Int
  newValue    Int
  triggeredBy String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Lead {
  id              String    @id @default(uuid())
  name            String
  email           String?
  phone           String?
  company         String?
  status          String    @default("new")
  source          String?
  notes           String?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  adSet           String?
  assignedById    String?
  assignedTo      String?
  campaignName    String?
  channel         String?
  convertedAt     DateTime?
  expectedValue   Float?
  followUpDate    DateTime?
  formId          String?
  formName        String?
  lastContactedAt DateTime?
  leadType        String?   @default("warm")
  lostReason      String?
  priority        String?   @default("medium")
  createdBy       String?
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  tags            Tag[]     @relation("LeadTags")

  @@unique([tenantId, email])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  contactId      String
  invoiceNumber  String        @unique
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(PENDING)
  subtotal       Float
  tax            Float
  discount       Float
  total          Float
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  currency       String        @default("NGN")
  idempotencyKey String?
  contact        Contact       @relation(fields: [contactId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  lineItems      LineItem[]    @relation("InvoiceLineItems")
  payments       Payment[]
}

model LineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  invoice     Invoice  @relation("InvoiceLineItems", fields: [invoiceId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  invoiceId      String
  amount         Float
  method         String
  status         PaymentStatus
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  idempotencyKey String?
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
}

model WhatsAppMessage {
  id         String           @id @default(uuid())
  tenantId   String
  contactId  String
  message    String
  status     MessageStatus    @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  direction  MessageDirection @default(OUTGOING)
  error      String?
  messageId  String?
  receivedAt DateTime?
  contact    Contact          @relation(fields: [contactId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
}

model LedgerEntry {
  id            String     @id @default(cuid())
  tenantId      String
  type          LedgerType
  amount        Decimal
  description   String
  accountId     String
  reference     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  date          DateTime   @default(now()) @db.Timestamptz(6)
  category      String?
  paymentMethod String?
  accountCode   String?
  currency      String     @default("NGN")
  fxRate        Decimal?   @db.Decimal
  notes         String?
  account       Account    @relation(fields: [accountId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Account {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  type      AccountType
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  entries   LedgerEntry[]
}

model TenantSettings {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  businessName     String?
  logoUrl          String?
  primaryColor     String?  @default("#000000")
  currency         String?  @default("NGN")
  language         String?  @default("en")
  invoicePrefix    String?  @default("INV-")
  invoiceStart     Int?     @default(1000)
  taxRate          Float?   @default(0.0)
  notifyByEmail    Boolean  @default(true)
  notifyByWhatsApp Boolean  @default(true)
  phoneNumber      String?
  emailAddress     String?
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  invoiceDueDays   Int?     @default(30)
  invoiceNote      String?
  timezone         String?  @default("Africa/Lagos")
  website          String?
  metadata         Json?
  webhookToken     String?  @unique
  receiptLogoUrl   String?
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  model     String
  modelId   String?
  details   Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  notifyByEmail    Boolean  @default(true)
  notifyByWhatsApp Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  channel   String
  recipient String
  content   String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CustomField {
  id                String             @id @default(cuid())
  tenantId          String
  entity            String
  name              String
  type              String
  required          Boolean            @default(false)
  options           String?
  defaultValue      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customFieldValues CustomFieldValue[]

  @@unique([tenantId, entity, name])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String
  entityId      String
  value         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
}

model CurrencyRate {
  id        String   @id @default(cuid())
  base      String
  target    String
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([base, target])
}

model Form {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  title           String
  description     String?
  formType        String           @default("LEAD_CAPTURE")
  redirectUrl     String?
  successMessage  String           @default("Thank you for your submission!")
  theme           Json?
  styling         Json?
  integrations    Json?
  webhookUrl      String?
  isActive        Boolean          @default(true)
  isPublished     Boolean          @default(false)
  viewCount       Int              @default(0)
  submissionCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields          FormField[]
  submissions     FormSubmission[]

  @@index([tenantId])
}

model FormField {
  id              String   @id @default(uuid())
  formId          String
  fieldName       String
  label           String
  placeholder     String?
  fieldType       String
  isRequired      Boolean  @default(false)
  validationRules Json?
  options         Json?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model FormSubmission {
  id        String   @id @default(uuid())
  formId    String
  tenantId  String
  data      Json
  email     String?
  phone     String?
  name      String?
  ipAddress String?
  userAgent String?
  source    String?
  isRead    Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([tenantId])
  @@index([email])
  @@index([createdAt])
}

model LandingPage {
  id              String   @id @default(uuid())
  tenantId        String
  title           String
  slug            String
  description     String?
  content         Json
  heroImage       String?
  formId          String?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  isPublished     Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  metadata           Json?
  billingCycle       String             @default("monthly")
  trialUsed          Boolean            @default(false)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Warehouse {
  id                 String           @id @default(uuid())
  tenantId           String
  name               String
  code               String?
  type               String           @default("local")
  country            String           @default("Nigeria")
  city               String?
  address            String?
  currency           String           @default("NGN")
  defaultDeliveryFee Float            @default(0)
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  notes              String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  isDefault          Boolean          @default(false)
  transfersFrom      StockTransfer[]  @relation("TransferFrom")
  transfersTo        StockTransfer[]  @relation("TransferTo")
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseStocks    WarehouseStock[]

  @@index([tenantId])
}

model WarehouseStock {
  id          String    @id @default(uuid())
  tenantId    String
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([tenantId])
  @@index([productId])
}

model StockTransfer {
  id              String    @id @default(uuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  productId       String
  quantity        Int
  status          String    @default("completed")
  carrier         String?
  deliveryFee     Float     @default(0)
  trackingNumber  String?
  notes           String?
  transferredBy   String?
  ledgerEntryId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model Order {
  id              String      @id @default(uuid())
  tenantId        String
  userId          String?
  assignedTo      String?
  leadId          String?
  totalAmount     Float       @default(0)
  status          String      @default("pending")
  notes           String?
  deliveryAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  orderItems      OrderItem[]

  @@index([tenantId])
  @@index([assignedTo])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  quantity  Int      @default(1)
  price     Float    @default(0)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ProductType {
  product
  service
  bundle
  combo
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum MessageDirection {
  OUTGOING
  INCOMING
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum AccountType {
  REVENUE
  EXPENSE
  ASSET
  LIABILITY
}

enum Plan {
  FREE
  PRO
  BUSINESS
  STARTER
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
